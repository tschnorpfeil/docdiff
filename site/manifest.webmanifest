{
  "name": "Doc Diff",
  "short_name": "DocDiff",
  "description": "Zwei Vertragsfassungen vergleichen, Wort für Wort markiert: PDF, Word oder Text. Läuft lokal im Browser, ohne Upload, auch offline. Kostenlos, Open Source.",
  "lang": "de",
