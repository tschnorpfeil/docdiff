{
  "name": "Doc Diff",
  "short_name": "DocDiff",
  "description": "Compare two versions of a contract, marked word by word: PDF, Word or text. Runs locally in your browser, no upload, works offline. Free and open source.",
  "lang": "en",
  "id": "/en/",
  "start_url": "/en/",
  "scope": "/en/",
  "display": "standalone",
  "background_color": "#060606",
  "theme_color": "#060606",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
